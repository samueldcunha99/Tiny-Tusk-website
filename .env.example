# Public browser configuration. These values are embedded into the Vite build.
VITE_BOOKING_API_URL=https://YOUR_PROJECT.supabase.co/functions/v1/submit-booking
VITE_TURNSTILE_SITE_KEY=replace-with-cloudflare-turnstile-site-key

# Server-only values are configured with `supabase secrets set`; never prefix
# them with VITE_ and never commit real values.
# BOOKING_ALLOWED_ORIGINS=https://your-production-domain.example,http://localhost:5173
# TURNSTILE_SECRET_KEY=replace-with-turnstile-secret
# RESEND_API_KEY=replace-with-resend-api-key
# RESEND_FROM_EMAIL=Tiny Tusk <appointments@your-domain.example>
# CLINIC_NOTIFICATION_EMAIL=replace-with-verified-clinic-address
