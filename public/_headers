# Netlify headers. Built scripts carry a content hash in their names, and the
# fonts never change, so both can be cached for a year. Images keep their
# names when replaced, so they get a week.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/images/*
  Cache-Control: public, max-age=604800
